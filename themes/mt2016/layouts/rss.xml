{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
{{- $posts := where site.RegularPages "Section" "post" }}
{{- $pages := .Pages }}
{{- if .IsHome }}{{ $pages = $posts }}{{ end }}
{{- $last := now }}
{{- with $posts.ByDate.Reverse }}{{ $last = (index . 0).Date }}{{ end }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    {{- $feedTitle := site.Title }}
{{- if not .IsHome }}
  {{- if eq .Kind "term" }}{{ $feedTitle = printf "%s | Marco Troisi" (partial "term-title.html" .Data.Term) }}
  {{- else }}{{ $feedTitle = printf "%s | Marco Troisi" .Title }}{{ end }}
{{- end }}
    <title>{{ $feedTitle }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ site.Params.description }}</description>
    <language>{{ site.Language.Locale | default "en-GB" }}</language>
    <lastBuildDate>{{ $last.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</lastBuildDate>
    <atom:link href="{{ .Permalink }}index.xml" rel="self" type="application/rss+xml"/>
    {{- range first 20 $pages.ByDate.Reverse }}
    <item>
      <title>{{ if eq .Kind "term" }}{{ partial "term-title.html" .Data.Term }}{{ else }}{{ .Title }}{{ end }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
      <guid isPermaLink="true">{{ .Permalink }}</guid>
      <description>{{ .Description | default (.Summary | plainify | truncate 300) | html }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
